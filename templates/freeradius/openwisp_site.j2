server default {
    listen {
        type = auth
        ipaddr = {{ freeradius_openwisp_site_listen_ipaddr }}
        port = 0
        limit {
            max_connections = 16
            lifetime = 0
            idle_timeout = 30
        }
    }

    listen {
        ipaddr = {{ freeradius_openwisp_site_listen_ipaddr }}
        port = 0
        type = acct
        limit {}
    }

    authorize {
        filter_username
        rest
        expiration
        logintime
    }

    authenticate {
        Auth-Type PAP {
            pap
        }

        Auth-Type CHAP {
            chap
        }

        Auth-Type MS-CHAP {
            mschap
        }

        Auth-Type EAP {
            eap
        }
    }

    preacct {
        preprocess
        acct_unique
        suffix
        files
        acct_counters64
        # An absent counter must stay blank so OpenWISP keeps the last reported total.
        if (!&Acct-Input-Octets && !&Acct-Input-Gigawords) {
            update request {
                &Acct-Input-Octets64 !* ANY
            }
        }
        if (!&Acct-Output-Octets && !&Acct-Output-Gigawords) {
            update request {
                &Acct-Output-Octets64 !* ANY
            }
        }
    }

    accounting {
        rest
    }

    session {}

    post-auth {
        rest

        Post-Auth-Type REJECT {
            rest
        }
    }

    pre-proxy {}
    post-proxy {}
}
